# Multi-stage build for React UI with protobuf TypeScript code generation

# Stage 1: Generate protobuf TypeScript code
FROM node:22-alpine AS proto-builder

# Install Go for buf
RUN apk add --no-cache git go

# Set Go environment
ENV GOPATH=/go
ENV PATH="${GOPATH}/bin:${PATH}"

# Install buf
RUN go install github.com/bufbuild/buf/cmd/buf@latest

# Install TypeScript protobuf generators (v2, protoc-gen-connect-es not needed in Connect v2)
RUN npm install -g @bufbuild/protoc-gen-es@^2.2.0

# Copy proto files and buf configuration
WORKDIR /app
COPY proto/ ./proto/

# Generate TypeScript code (outputs to ../ui/app/gen from proto directory)
WORKDIR /app/proto
RUN buf dep update && \
  buf lint && \
  buf generate --template buf.gen.ts.yaml && \
  echo "=== Generated files ===" && \
  find ../ui/app/gen/ -type f | head -20

# Stage 2: Install development dependencies
FROM node:22-alpine AS development-dependencies-env
COPY ui/package.json ui/package-lock.json /app/
WORKDIR /app
RUN npm ci

# Stage 3: Install production dependencies
FROM node:22-alpine AS production-dependencies-env
COPY ui/package.json ui/package-lock.json /app/
WORKDIR /app
RUN npm ci --omit=dev

# Stage 4: Build the application
FROM node:22-alpine AS build-env
WORKDIR /app
COPY ui/ ./
COPY --from=development-dependencies-env /app/node_modules ./node_modules
# Copy generated TypeScript files from proto-builder
COPY --from=proto-builder /app/ui/app/gen ./app/gen
# Verify the files are there
RUN ls -la ./app/gen/ && find ./app/gen/ -type f && npm run build

# Stage 5: Final runtime image
FROM node:22-alpine
WORKDIR /app
COPY ui/package.json ui/package-lock.json ./
COPY --from=production-dependencies-env /app/node_modules ./node_modules
COPY --from=build-env /app/build ./build
CMD ["npm", "run", "start"]
